# Copy to .env and fill in. The file must be named exactly ".env".
# Pick PORT before registering OAuth redirect URIs — the app derives the
# redirect URIs from it, and they must match what you register exactly.
PORT=3000

# Set HEADLESS=1 to suppress the visible scraper browser window.
HEADLESS=0

# Google (Gmail) — https://console.cloud.google.com/
# Enable "Gmail API"; OAuth consent scope https://www.googleapis.com/auth/gmail.compose
# Web application redirect URI: http://localhost:<PORT>/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (personal Outlook.com / Hotmail) — https://portal.azure.com/
# App registration, "Personal Microsoft accounts only".
# Web redirect URI: http://localhost:<PORT>/oauth/microsoft/callback
# Delegated Microsoft Graph permission: Mail.ReadWrite
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
