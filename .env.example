PORT=3000

# Google Cloud OAuth client (Web application type)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure App registration (Personal Microsoft accounts only)
# https://portal.azure.com -> Microsoft Entra ID -> App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Scraper ──────────────────────────────────────────────────────
# Show the browser while scraping. Set to 1 to run headless.
HEADLESS=

# Tunnels you run yourself, e.g. from scripts/build-wireproxy.js. When set,
# these are the whole pool and the public lists below are ignored.
PROXY_STATIC=
# Public proxy lists, used when PROXY_STATIC is empty. Comma-separated;
# defaults to several sources merged, since any one of them is mostly dead.
PROXY_LIST_URLS=
# How many usable proxies to keep, and how far below that before topping up
# mid-run — public entries die constantly.
PROXY_POOL_TARGET=12
PROXY_POOL_MIN=4
# Candidates probed per sweep, and how many at once.
PROXY_MAX_TRIES=400
PROXY_PROBE_BATCH=50
USE_PROXY=
PROXY_TIMEOUT_MS=20000
# Minimum gap between two requests through the same exit.
PROXY_IP_COOLDOWN_MS=30000
# Challenges before an exit is benched, and how long it sits out. Benched is
# temporary — these recover with rest, and dropping them for good empties the
# pool mid-run.
PROXY_BURN_LIMIT=2
PROXY_PENALTY_MS=600000
# Longest a post will wait for a rested tunnel before being skipped.
PROXY_MAX_WAIT_MS=300000
# Attempts per post and per listing. Each one uses an exit that item has not
# already tried.
PROXY_ATTEMPTS_PER_POST=5
PROXY_LISTING_ATTEMPTS=3
# Set to 1 to let a run continue on your own IP when no tunnel is free.
# Off by default: a run set up to rotate shouldn't quietly stop rotating.
ALLOW_DIRECT_FALLBACK=

# Seconds to wait before relaunching the browser after a CAPTCHA.
CAPTCHA_COOLDOWN_MS=15000

# Posts per area per category. 0 (or unset) takes everything the search
# returns — a scrape runs as a background job, so it is no longer bounded by
# how long a browser will wait for a response.
MAX_POSTS_PER_AREA=0
POST_CONCURRENCY=6
# Set to 0 to include listings older than today.
POSTED_TODAY=
