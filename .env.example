PORT=3000

# Google Cloud OAuth client (Web application type)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure App registration (Personal Microsoft accounts only)
# https://portal.azure.com -> Microsoft Entra ID -> App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Scraper ──────────────────────────────────────────────────────
# Show the browser while scraping. Set to 1 to run headless.
HEADLESS=

# Rotate the exit IP through your own WireGuard tunnels. Generate them from
# the Surfshark configs in proxies/ with:
#     node scripts/build-wireproxy.js
#     for f in vpn/wireproxy/*.conf; do wireproxy -d -s -c "$f"; done
# then paste the printed list here. Leave empty to scrape on your own IP.
PROXY_STATIC=
USE_PROXY=
PROXY_TIMEOUT_MS=20000
# Minimum gap between two requests through the same exit.
PROXY_IP_COOLDOWN_MS=30000
# Challenges before an exit is benched, and how long it sits out. Benched is
# temporary — these recover with rest, and dropping them for good empties the
# pool mid-run.
PROXY_BURN_LIMIT=2
PROXY_PENALTY_MS=600000
# Longest a post will wait for a rested tunnel before being skipped.
PROXY_MAX_WAIT_MS=300000
# Set to 1 to let a run continue on your own IP when no tunnel is free.
# Off by default: a run set up to rotate shouldn't quietly stop rotating.
ALLOW_DIRECT_FALLBACK=

# Seconds to wait before relaunching the browser after a CAPTCHA.
CAPTCHA_COOLDOWN_MS=15000

# Posts per area per category, and how many run at once.
MAX_POSTS_PER_AREA=25
POST_CONCURRENCY=6
# Set to 0 to include listings older than today.
POSTED_TODAY=
