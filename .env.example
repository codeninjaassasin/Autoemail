PORT=3000

# Google Cloud OAuth client (Web application type)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure App registration (Personal Microsoft accounts only)
# https://portal.azure.com -> Microsoft Entra ID -> App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Scraper ──────────────────────────────────────────────────────
# Show the browser while scraping. Set to 1 to run headless.
HEADLESS=

# Rotate the exit IP through ProxyScrape's free list. Set to 0 to scrape on
# your own connection instead. The free list is mostly dead — expect ~1 in 20
# to work — so each session probes a batch concurrently before giving up and
# falling back to a direct connection (which the UI flags in red).
USE_PROXY=
PROXY_LIST_URL=
PROXY_TIMEOUT_MS=8000
PROXY_MAX_TRIES=60
PROXY_PROBE_BATCH=20

# Seconds to wait before relaunching the browser after a CAPTCHA.
CAPTCHA_COOLDOWN_MS=15000
