PORT=3000

# Google Cloud OAuth client (Web application type)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure App registration (Personal Microsoft accounts only)
# https://portal.azure.com -> Microsoft Entra ID -> App registrations
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Scraper ──────────────────────────────────────────────────────
# Show the browser while scraping. Set to 1 to run headless.
HEADLESS=

# Tunnels you run yourself, e.g. from scripts/build-wireproxy.js. When set,
# these are the whole pool and the public lists below are ignored.
PROXY_STATIC=
# Public proxy lists, used when PROXY_STATIC is empty. Comma-separated;
# defaults to several sources merged, since any one of them is mostly dead.
PROXY_LIST_URLS=
# The proxy finder runs continuously and uncapped. Its gate is a real HTTPS
# fetch of Craigslist through the proxy — a TCP connect only proved something
# was listening, and ~80% of scraping failures were then ERR_TIMED_OUT from
# proxies that connected and could not tunnel, each holding a worker for a full
# navigation timeout.
PROXY_TARGET_HOST=www.craigslist.org
PROXY_TIMEOUT_MS=20000
# Narrower is better. Batch width does not change how many verified proxies
# you get per minute (measured flat at ~190/4min from 500 to 3000) — the finder
# is demand-gated. It changes the false-negative rate: probes time out under
# concurrency, and a failed probe blocks that proxy for the run. 500 burns 13
# candidates per verified exit; 3000 burns 41.
PROXY_PROBE_BATCH=300
PROXY_REFETCH_IDLE_MS=60000
# There is no ready list: a verified proxy is handed straight to a worker that
# is already waiting. When none is waiting the finder idles rather than proving
# exits that would be stale by the time anyone asked for them.
PROXY_IDLE_POLL_MS=500

# Proxies that produce a contact are remembered in data/proxies.json and
# reused on later runs. This many blocks across different posts retires one.
PROXY_BLOCK_LIMIT=10
# Reachable-but-unproven proxies are cached too, so a restart doesn't repeat
# the sweep that found them. They expire because free proxies die — a stale
# entry costs a timeout before it's discovered.
PROXY_REACHABLE_TTL_MS=3600000
USE_PROXY=
# Attempts at a *listing* page. Posts have no ceiling — they are released only
# on a contact or a reply panel that opened empty.
PROXY_LISTING_ATTEMPTS=5
# How long a challenged exit sits out before rejoining the ready list. A
# CAPTCHA is throttling, not a verdict — the same exit answers again once left
# alone, and burning them discarded whichever proxies were working hardest.
PROXY_RELAX_MS=600000
# Blocks expire too. A failed probe is not a verdict: pass rate is 2.4% at a
# batch of 3000 against 9.4% at 300, so many blocks are false negatives caused
# by our own concurrency. And the lists yield only ~340 new candidates a minute
# against 400+ consumed, so permanent blocks drain the pool. Repeat failures
# back off 30min, 60, 120, then the address is dropped for good.
PROXY_BLOCK_TTL_MS=1800000
PROXY_BLOCK_MAX_ATTEMPTS=4

# Page waits. Defaults suit public proxies, which are slow enough that shorter
# waits read as "blocked" when the page was merely still loading. Lower them
# if you're running through fast tunnels of your own.
#
# 40s suited a small pool of tunnels that mostly worked. The finder now feeds a
# large pool that mostly does not: ~80% of failures are ERR_TIMED_OUT from
# proxies that accept a TCP connection but cannot tunnel to Craigslist, and
# each one holds a worker for the full timeout. Measured over the same 3
# minutes with 74 workers: 40000 gave 3 posts, 12000 gave 6.
NAV_TIMEOUT_MS=12000
BODY_TIMEOUT_MS=15000
REPLY_PANEL_TIMEOUT_MS=20000

# Posts per area per category. 0 (or unset) takes everything the search
# returns — a scrape runs as a background job, so it is no longer bounded by
# how long a browser will wait for a response.
MAX_POSTS_PER_AREA=0
# Workers are sized by memory, not by a fixed number: the set grows until
# available RAM would drop below the floor. On darwin availability is read from
# vm_stat — os.freemem() counts only wholly free pages and reports ~200MB on a
# 32GB machine, which pinned the pool to its minimum.
# Workers are capped by proxy supply, not memory. Memory allowed 74 on a 32GB
# machine and that is what ran: every worker starved for three minutes straight,
# 94% of leased exits completed zero posts, and twelve minutes yielded 13
# emails. Free lists verify at ~2% pool-wide and cannot feed that many browsers.
WORKER_MAX=15
WORKER_MEM_FLOOR_MB=2000
WORKER_MEM_PER_MB=220
WORKER_MEM_FRACTION=0.5
WORKER_MIN=4
# How often the run goes back for newly posted listings. It never finishes.
LISTING_REFRESH_MS=300000
# How long before a scraped post is opened again. Listings get edited,
# reposted, and gain contact methods after the fact, and the listing page
# carries only the URL - the posted date lives on the post itself - so a
# re-read on a schedule is the only way to notice. A re-read that finds the
# same contacts refreshes their provenance and writes nothing new.
# Dead posts wait longer: no contact published is usually lasting, not permanent.
POST_REFRESH_MS=21600000
POST_DEAD_REFRESH_MS=86400000
# Set to 0 to include listings older than today.
POSTED_TODAY=
# Sections to scrape. Defaults to the ones where individuals want to be paid:
# resumes (seeking work), services (selling labour), for sale (selling goods).
# Excluded by default: jobs and gigs are employers offering work, housing is
# landlords, community and events are neither.
#   ccc community · eee events · sss for sale · ggg gigs
#   hhh housing   · jjj jobs   · rrr resumes  · bbb services
CATEGORIES=rrr,sss
